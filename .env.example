# Mật khẩu vào /admin. Bắt buộc khi chạy production (thiếu = admin bị khoá).
# Khi dev mà bỏ trống thì mật khẩu mặc định là "admin".
ADMIN_PASSWORD=

# Khoá ký cookie phiên admin. Bỏ trống = dẫn xuất từ ADMIN_PASSWORD.
SESSION_SECRET=

# File SQLite của CMS. Mặc định: ./data/game.db
DATABASE_PATH=

# Cổng HTTP (Next.js + Socket.IO chạy chung một cổng).
PORT=3000
