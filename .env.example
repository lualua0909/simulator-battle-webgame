# Firebase Admin (bắt buộc cho đăng nhập, CMS + nội dung game trên Firestore, quản lý user, FCM).
# Service account JSON (Firebase Console > Project settings > Service accounts), dán nguyên JSON hoặc base64.
# Bỏ trống = dùng GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=

# Email (cách nhau dấu phẩy) tự thành root (role 0) khi đăng nhập với email đã xác minh (vd. Google).
# Chỉ root/admin (role 0/1) vào được /admin; user mới mặc định role 2.
FIREBASE_ROOT_EMAILS=

# Web Push certificate key (Project settings > Cloud Messaging) để lấy FCM token. Bỏ trống = không đăng ký FCM.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Cấu hình web Firebase: đã có mặc định cho project simulator-aaa80 trong src/lib/firebase.ts.
# NEXT_PUBLIC_FIREBASE_API_KEY= NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= NEXT_PUBLIC_FIREBASE_PROJECT_ID= ...

# File SQLite cũ, chỉ đọc một lần để chuyển nội dung CMS sang Firestore. Mặc định: ./data/game.db
DATABASE_PATH=

# Cổng HTTP (Next.js + Socket.IO chạy chung một cổng).
PORT=3000

# Nơi deploy. `vercel` = ẩn + tắt những gì Vercel không chạy được: đấu online, xếp hạng (Socket.IO),
# upload .glb (ghi đĩa), giám sát máy chủ (số liệu trong RAM).
# Đặt lúc build (Vercel: Project Settings > Environment Variables). Bỏ trống = máy chủ Node đủ tính năng.
SERVER=

# Nạp xu VietQR: tài khoản nhận tiền (mặc định như ảnh mẫu: Techcombank 6162991994 NGUYEN ANH DUY).
# NEXT_PUBLIC_TOPUP_BANK_ID=TCB
# NEXT_PUBLIC_TOPUP_BANK_NAME=Techcombank
# NEXT_PUBLIC_TOPUP_ACCOUNT_NO=6162991994
# NEXT_PUBLIC_TOPUP_ACCOUNT_NAME=NGUYEN ANH DUY
# NEXT_PUBLIC_TOPUP_QR_TEMPLATE=compact2
