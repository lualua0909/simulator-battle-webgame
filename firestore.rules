rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All writes go through the server (Admin SDK bypasses these rules); the web client
    // never uses the Firestore SDK — the game reads /api/config, the CMS uses /api/admin.

    // users/{uid}: profile created by /api/auth/session. Owner may read only their own doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // players/{uid} (coins, cards, stars, box timers) and its ledger: server only, even for the owner.
    // Every change runs in a server transaction; the game reads the wallet through /api/player.
    match /players/{path=**} {
      allow read, write: if false;
    }

    // Everything else (units, weapons, … CMS content, settings/global, matches): server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
