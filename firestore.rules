rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles are written only by the server (Admin SDK bypasses rules).
    // CMS content (units, weapons, …, settings) has no rule: clients never touch it, the game reads /api/config.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
