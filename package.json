{
  "name": "simulator-battle",
  "version": "0.1.0",
  "private": true,
  "description": "Low-poly wobbly battle simulator (TABS-like) on the web: Next.js + Three.js, vs AI / local / online PvP, custom CMS.",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
